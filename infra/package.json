    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "aws-cdk": "2.1147.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
